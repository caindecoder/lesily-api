APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Tests run against MySQL (parity with production + CI; matches LeaveDates).
# Create a local `lesily_test` database, then copy this file to `.env.testing`
# and fill in your local MySQL credentials. `.env.testing` is gitignored.
# CI does NOT use this file — it relies on `.env.github` (root / empty password).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lesily_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BCRYPT_ROUNDS=4
