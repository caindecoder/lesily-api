{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: ["app"],
        excludes: ["Console", "Exceptions", "Providers"]
    },
    // 180s: at 30s every mutant covered only by ~10s-boot feature tests
    // TIME-SKIPS locally (s164 class — skipped mutants leave the MSI
    // denominator, a gate that stops looking; 50/56 skipped on the s178
    // OQ-1-162 run). CI on Linux kills well inside either bound.
    timeout: 180,
    logs: {
        text: "infection.log",
        html: "infection.html",
        json: "infection.json",
        summary: "infection-summary.log"
    },
    mutators: {
        "@default": true,
        // ProtectedVisibility produces equivalent mutants (protected -> private is
        // behaviorally identical on leaf-class internal helpers with no override).
        // Disabled project-wide as a principled equivalent-mutant exclusion, keeping
        // LeaveDates' protected-helper convention. See OQ-1-095 (UC-1-097 redo, 2026-05-29).
        "ProtectedVisibility": false,
        // PublicVisibility on Eloquent static finders is an equivalent mutant: calling
        // Role::findByCode() works identically whether the method is public OR protected,
        // because Model::__callStatic forwards Role::findByCode() to (new static)->findByCode()
        // from Model scope (a parent class), which CAN reach Role's protected method. No
        // behavioral test can distinguish the two; only a forbidden reflection visibility test
        // (Rule #13) could. Scoped to this ONE method — NOT global: public->protected stays a
        // real, killable regression on controllers/services/value-objects, and even on the
        // sibling Role::permissions() relation (resolved from Builder scope, no protected access).
        // See OQ-1-099 (UC-1-136 redo, 2026-05-30).
        //
        // PublicVisibility on a spatie projector/reactor handler (onX methods) is an
        // equivalent mutant: Spatie\EventSourcing HandlesEvents discovers handlers via
        // Handlers::new($this)->public()->protected(), so it invokes the handler whether
        // it is public OR protected — public->protected changes nothing observable. The
        // only way to "kill" it is to call the handler directly (needs public), i.e. a
        // forbidden reflection/visibility test (Rule #13) that also spies ES internals
        // (slice §6). Scoped to projector + reactor handlers ONLY — public->protected stays a
        // real, killable regression elsewhere. Add new projector/reactor handlers here as they
        // land (or switch to a wildcard if they proliferate). See increment #05, PR #39
        // (2026-06-02) for projectors; increment #08 (2026-06-04) for the reactor.
        "PublicVisibility": {
            ignore: [
                "App\\Foundation\\RolesPermissions\\Entities\\Role::findByCode",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyCreated",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyTrialExpired",
                "App\\Billing\\Subscriptions\\Projectors\\SubscriptionProjector::onSubscriptionTrialStarted",
                "App\\Billing\\Subscriptions\\Projectors\\SubscriptionProjector::onSubscriptionTrialEnded",
                "App\\Companies\\Reactors\\TrialExpiredEmailReactor::onCompanyTrialExpired",
                // company-onboarding #04 (PR #47, 2026-06-12): CI cold flagged the new
                // EC handler — same equivalent class as the entries above.
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserMembershipEmergencyContactSet",
                // company-onboarding #07 (PR #50, 2026-06-14): CI cold flagged the welcome
                // reactor handler — confirmed equivalent (protected still sends; local
                // Xdebug falsely killed it, CI/PCOV escaped — amendment H).
                "App\\Foundation\\Auth\\Reactors\\WelcomeEmailReactor::onUserSignedUpAsOwner",
                // password slice / UC-1-016 (change own password): the new password-write
                // projector handler — same equivalent class (protected still projects).
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserPasswordChanged",
                // password slice #2 / UC-1-016: the password-changed confirmation reactor
                // handler — same spatie-discovery equivalent class as WelcomeEmailReactor /
                // TrialExpiredEmailReactor above (protected still fires the notice).
                "App\\Foundation\\Auth\\Reactors\\PasswordChangedNotificationReactor::onUserPasswordChanged",
                // password slice #4 / UC-1-008 (reset password): the reset-password projector arm +
                // the shared confirmation reactor's reset arm — same spatie-discovery equivalent
                // class (protected still projects / fires the notice).
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserPasswordReset",
                "App\\Foundation\\Auth\\Reactors\\PasswordChangedNotificationReactor::onUserPasswordReset",
                // membership slice Task 5 / UC-1-022 (revoke invitation): the revoke
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the revocation stamps).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserInvitationRevoked",
                // membership slice Task 6 / UC-1-023 (change role): the role-change
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the role_id write).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserMembershipRoleChanged",
                // membership slice Task 7 / UC-1-024 (remove member): the removal
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the soft-delete stamp).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserRemovedFromCompany",
                // slice-#10 T3 (invoice domain foundation): the six InvoiceProjector
                // lifecycle arms — same spatie-discovery equivalent class (protected
                // still projects; declared at PAUSE 1, pin P5).
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceCreated",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoicePaid",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoicePaymentFailed",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceRefunded",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceVoided",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceDisputeFiled",
            ],
        },
        // SpreadOneItem on BillingPlan::features() is an equivalent mutant: the only
        // spread there is Pro's `[...self::Starter->features(), TwoFactorAuth]`, and
        // Starter grants exactly ONE feature in chunk-1 — so "spread only the first
        // item" yields an identical array. Becomes killable (and this exclusion should
        // be removed) once Starter grants 2+ features. Sibling mutators (SpreadRemoval,
        // ArrayItemRemoval) stay active and ARE killed by the allow-matrix tests.
        // See OQ-1-100 (UC-1-055 redo, 2026-05-30).
        "SpreadOneItem": {
            ignore: [
                "App\\Foundation\\Billing\\Enums\\BillingPlan::features",
            ],
        },
    },
    minMsi: 80,
    minCoveredMsi: 85,
    testFramework: "phpunit"
}
