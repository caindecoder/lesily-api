{
    $schema: "vendor/infection/infection/resources/schema.json",
    source: {
        directories: ["app"],
        excludes: ["Console", "Exceptions", "Providers"]
    },
    // 420 s (OQ-1-181 arm b, s201). Infection time-skips a mutant BEFORE running
    // it when its covering set's initial-run time is >= this value
    // (MutationTestingRunner::takingTooLong), and a skip leaves the MSI
    // denominator silently — a gate that stops looking. The whole-suite-covered
    // set (the module service providers, LesilyStoredEvent, User) measured
    // 161–185 s on the private 2-vCPU runner (runs 33830650938 / 33783192768)
    // and straddled the old 180: 0 vs 14 skipped on identical code. 420 = 2 x
    // 185 rounded up to a minute. A mutant that runs gets min(5 + 5 x covering
    // time, 420), so only covering sets over 35 s see a different budget; a
    // genuine hang in that class now costs up to 7 min, bounded by
    // mutation.yml's timeOutCount <= 10. History: 30 -> 120 (s152) -> 180
    // (s178: the ~10-s-boot feature-test class skipped locally at 30) -> 420.
    // Record the runner class beside any re-measure (a timing on one runner
    // class is not a pin for another).
    timeout: 420,
    logs: {
        text: "infection.log",
        html: "infection.html",
        json: "infection.json",
        summary: "infection-summary.log"
    },
    mutators: {
        "@default": true,
        // ProtectedVisibility produces equivalent mutants (protected -> private is
        // behaviorally identical on leaf-class internal helpers with no override).
        // Disabled project-wide as a principled equivalent-mutant exclusion, keeping
        // LeaveDates' protected-helper convention. See OQ-1-095 (UC-1-097 redo, 2026-05-29).
        "ProtectedVisibility": false,
        // PublicVisibility on Eloquent static finders is an equivalent mutant: calling
        // Role::findByCode() works identically whether the method is public OR protected,
        // because Model::__callStatic forwards Role::findByCode() to (new static)->findByCode()
        // from Model scope (a parent class), which CAN reach Role's protected method. No
        // behavioral test can distinguish the two; only a forbidden reflection visibility test
        // (Rule #13) could. Scoped to this ONE method — NOT global: public->protected stays a
        // real, killable regression on controllers/services/value-objects, and even on the
        // sibling Role::permissions() relation (resolved from Builder scope, no protected access).
        // See OQ-1-099 (UC-1-136 redo, 2026-05-30).
        //
        // PublicVisibility on a spatie projector/reactor handler (onX methods) is an
        // equivalent mutant: Spatie\EventSourcing HandlesEvents discovers handlers via
        // Handlers::new($this)->public()->protected(), so it invokes the handler whether
        // it is public OR protected — public->protected changes nothing observable. The
        // only way to "kill" it is to call the handler directly (needs public), i.e. a
        // forbidden reflection/visibility test (Rule #13) that also spies ES internals
        // (slice §6). Scoped to projector + reactor handlers ONLY — public->protected stays a
        // real, killable regression elsewhere. Add new projector/reactor handlers here as they
        // land (or switch to a wildcard if they proliferate). See increment #05, PR #39
        // (2026-06-02) for projectors; increment #08 (2026-06-04) for the reactor.
        "PublicVisibility": {
            ignore: [
                "App\\Foundation\\RolesPermissions\\Entities\\Role::findByCode",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyCreated",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyTrialExpired",
                "App\\Billing\\Subscriptions\\Projectors\\SubscriptionProjector::onSubscriptionTrialStarted",
                "App\\Billing\\Subscriptions\\Projectors\\SubscriptionProjector::onSubscriptionTrialEnded",
                "App\\Companies\\Reactors\\TrialExpiredEmailReactor::onCompanyTrialExpired",
                // company-onboarding #04 (PR #47, 2026-06-12): CI cold flagged the new
                // EC handler — same equivalent class as the entries above.
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserMembershipEmergencyContactSet",
                // company-onboarding #07 (PR #50, 2026-06-14): CI cold flagged the welcome
                // reactor handler — confirmed equivalent (protected still sends; local
                // Xdebug falsely killed it, CI/PCOV escaped — amendment H).
                "App\\Foundation\\Auth\\Reactors\\WelcomeEmailReactor::onUserSignedUpAsOwner",
                // password slice / UC-1-016 (change own password): the new password-write
                // projector handler — same equivalent class (protected still projects).
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserPasswordChanged",
                // password slice #2 / UC-1-016: the password-changed confirmation reactor
                // handler — same spatie-discovery equivalent class as WelcomeEmailReactor /
                // TrialExpiredEmailReactor above (protected still fires the notice).
                "App\\Foundation\\Auth\\Reactors\\PasswordChangedNotificationReactor::onUserPasswordChanged",
                // password slice #4 / UC-1-008 (reset password): the reset-password projector arm +
                // the shared confirmation reactor's reset arm — same spatie-discovery equivalent
                // class (protected still projects / fires the notice).
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserPasswordReset",
                "App\\Foundation\\Auth\\Reactors\\PasswordChangedNotificationReactor::onUserPasswordReset",
                // membership slice Task 5 / UC-1-022 (revoke invitation): the revoke
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the revocation stamps).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserInvitationRevoked",
                // membership slice Task 6 / UC-1-023 (change role): the role-change
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the role_id write).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserMembershipRoleChanged",
                // membership slice Task 7 / UC-1-024 (remove member): the removal
                // projector arm — same spatie-discovery equivalent class (protected
                // still projects the soft-delete stamp).
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserRemovedFromCompany",
                // slice-#10 T3 (invoice domain foundation): the six InvoiceProjector
                // lifecycle arms — same spatie-discovery equivalent class (protected
                // still projects; declared at PAUSE 1, pin P5).
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceCreated",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoicePaid",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoicePaymentFailed",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceRefunded",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceVoided",
                "App\\Billing\\Invoices\\Projectors\\InvoiceProjector::onInvoiceDisputeFiled",
                // OQ-1-172 PR-0 (s189) L-HANDLERS: the 17 remaining spatie on* handlers -
                // same discovery-equivalent class (HandlesEvents::getEventHandlingMethods
                // ->public()->protected(), vendor HandlesEvents.php:47-49). Design P4:
                // individual entries, no wildcard.
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserInvited",
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserInvitationResent",
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserInvitationExpired",
                "App\\Companies\\Memberships\\Projectors\\MembershipProjector::onUserJoinedCompany",
                "App\\Companies\\Memberships\\Reactors\\TeamWelcomeReactor::onUserJoinedCompany",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyDetailsUpdated",
                "App\\Companies\\Projectors\\CompanyProjector::onCompanyOwnershipTransferred",
                "App\\Companies\\Projectors\\CompanySettingsProjector::onCompanySettingsCreated",
                "App\\Companies\\Projectors\\CompanySettingsProjector::onCompanySettingsUpdated",
                "App\\Companies\\Reactors\\NewOwnerNotificationReactor::onCompanyOwnershipTransferred",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserSignedUpAsOwner",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserCreatedFromInvitation",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarRequestSubmitted",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarRequestCancelled",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarRequestFulfilled",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarRequestRejected",
                "App\\Compliance\\Dsar\\Reactors\\QueueDsarExportReactor::onDsarRequestSubmitted",
                "App\\Compliance\\Dsar\\Reactors\\DsarNotificationReactor::onDsarRequestFulfilled",
                "App\\Compliance\\Dsar\\Reactors\\DsarNotificationReactor::onDsarRequestRejected",
                "App\\Compliance\\Dsar\\Reactors\\DsarNotificationReactor::onDsarRequestCancelled",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarDownloadExpired",
                "App\\Compliance\\Dsar\\Reactors\\DeleteDsarExportFileReactor::onDsarDownloadExpired",
                "App\\Compliance\\Dsar\\Projectors\\DsarRequestProjector::onDsarSlaBreached",
                "App\\Compliance\\Dsar\\Reactors\\DsarNotificationReactor::onDsarSlaBreached",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserEmailVerified",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUserProfileUpdated",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUser2FAEnabled",
                "App\\Foundation\\Auth\\Projectors\\UserProjector::onUser2FADisabled",
                "App\\Foundation\\Auth\\Reactors\\EmailVerificationReactor::onUserSignedUpAsOwner",
                // OQ-1-172 PR-0 L-RELATIONS: lazy relations resolved from Model scope
                // (Model::getRelationValue calls $this->company() / $this->settings() from
                // inside the class, so protected still resolves); no with()/load() names
                // either relation anywhere in app/ today. REMOVE WHEN an eager-load lands:
                // Builder::with() calls the method from outside the class and the mutant
                // becomes a real, killable regression.
                "App\\Billing\\Invoices\\Entities\\Invoice::company",
                "App\\Companies\\Entities\\Company::settings",
                // The same class: the admin DSAR detail reads the request's company lazily.
                // REMOVE WHEN the admin DSAR queue (SLICE-dsar-access 10b) eager-loads it.
                "App\\Compliance\\Dsar\\Entities\\DsarRequestRecord::company",
                // OQ-1-172 PR-0 L-SCOPE: each is invoked from a scope that reaches
                // protected - envelope() by the parent Mailable, forCompany() by the
                // AggregateRoot subclasses, scopeWhereForCompany() via Model::callNamedScope.
                "App\\Companies\\Memberships\\Mail\\InvitationMail::envelope",
                "App\\Foundation\\EventStore\\AggregateRoot::forCompany",
                "App\\Foundation\\EventStore\\StoredEvents\\Models\\LesilyStoredEvent::scopeWhereForCompany",
            ],
        },
        // SpreadOneItem on BillingPlan::features() is an equivalent mutant: the only
        // spread there is Pro's `[...self::Starter->features(), TwoFactorAuth]`, and
        // Starter grants exactly ONE feature in chunk-1 — so "spread only the first
        // item" yields an identical array. Becomes killable (and this exclusion should
        // be removed) once Starter grants 2+ features. Sibling mutators (SpreadRemoval,
        // ArrayItemRemoval) stay active and ARE killed by the allow-matrix tests.
        // See OQ-1-100 (UC-1-055 redo, 2026-05-30).
        "SpreadOneItem": {
            ignore: [
                "App\\Foundation\\Billing\\Enums\\BillingPlan::features",
            ],
        },
        // ---- OQ-1-172 PR-0 (s189): the 61 ledgered escapes of the first honest nightly
        // (baseline run 32389214088: 277; 275 after T2 in run 32776584593, the run every
        // entry below was measured against). Design P4/P5/P8, Appendix A L-*. Entries
        // are individual; a "::<line>" suffix pins ONE construct wherever the method also
        // carries real, killable mutants of the same mutator (a method-level entry would
        // silence 7 rows owned by T4-T6 plus 18 mutants the suite kills today). If a
        // pinned method moves, the entry goes inert and the row re-escapes: the
        // full-run ladder check detects that. It does NOT detect over-reach - a method-level entry
        // also silences mutants added to that method LATER - so a method-level entry is
        // re-read whenever its method changes (same caveat as the entries above).
        //
        // L-OUTER-EQ: ArrayItemRemoval on the OUTER rules() array (the `return [` line).
        // Dropping the first key's entry is byte-equivalent because Spatie re-infers the
        // same required+type rules from the non-nullable typed property
        // (DataValidationRulesResolver per-key fallback); every listed first key is
        // ['required', 'string'] on a `public string` property. Inner-key removals in
        // the same methods stay live - they ARE killable (T5/T6 kills). REMOVE an entry
        // WHEN its command's FIRST key gains a rule beyond required+type, or the keys are
        // reordered so such a key comes first: the `return [` line does not move, but the
        // outer removal then drops a real constraint and becomes killable. (T6, s192:
        // the AcceptInvitationCommand entry was removed on exactly that clause - its
        // route-sourced token entry went, so password [nullable, string, min:8] became
        // the first key and the outer removal is now killed by the min-8 row.)
        // K-BILL-DOWNLOAD (OQ-1-172 T4, s190): DownloadInvoiceReceiptCommand is an
        // HTTP-boundary command (InvoicesController) whose two keys are BOTH server-
        // supplied (auth.company + the route parameter), so under the amendment-AQ
        // corollary they carry no rule of their own and the receipt contract has no
        // 422 (api-1-invoices s2). rules() stays only because the AQ guard's clause 1
        // requires one on every controller-referenced command; removing the outer
        // array or either key's entry is therefore equivalent (Spatie re-infers
        // required+string from the typed properties) - method-level, covering all
        // three literals in the method. REMOVE WHEN a client-supplied key lands on
        // this command, either key gains a rule beyond required+type, or the guard
        // learns the server-key corollary and rules() can go.
        "ArrayItemRemoval": {
            ignore: [
                "App\\Billing\\Invoices\\UseCases\\Commands\\DownloadInvoiceReceiptCommand::rules",
                "App\\Foundation\\Auth\\UseCases\\Commands\\ChangePasswordCommand::rules::19",
                "App\\Foundation\\Auth\\UseCases\\Commands\\ConfirmTwoFactorCommand::rules::22",
                "App\\Foundation\\Auth\\UseCases\\Commands\\DisableTwoFactorCommand::rules::23",
                "App\\Foundation\\Auth\\UseCases\\Commands\\LogoutAllCommand::rules::23",
                "App\\Foundation\\Auth\\UseCases\\Commands\\RegenerateRecoveryCodesCommand::rules::23",
                "App\\Foundation\\Auth\\UseCases\\Commands\\ResetPasswordCommand::rules::21",
                "App\\Foundation\\Auth\\UseCases\\Commands\\VerifyTwoFactorCommand::rules::30",
                // L-CHROMIUM: addChromiumArguments(['disable-dev-shm-usage']) is container
                // tuning (cd-invoices.md:34 names it as config); the rendered PDF bytes are
                // identical either way. Pinned so loadMissing('lineItems') at :24 stays killable.
                "App\\Billing\\Invoices\\IO\\Pdf\\ChromiumReceiptPdfRenderer::render::32",
                // L-CHROMIUM (DSAR report): the same container flag on the DSAR report
                // renderer; the PDF bytes are identical either way. Pinned so the blockUrls
                // items at :45 stay killable.
                "App\\Compliance\\Dsar\\IO\\Pdf\\ChromiumDsarReportRenderer::print::44",
                // L-VERIFY-BODY: the verify-email response message literal -
                // api-1-auth-onboarding.md:190 leaves the body unpinned (P5 tuning).
                "App\\Foundation\\Auth\\IO\\Http\\Controllers\\EmailVerificationController::__invoke",
            ],
        },
        // L-LOCKS: Cache::lock lease/wait seconds (5 -> 4/6) - array cache + a single
        // process cannot observe the difference; OQ-1-119 prescribes the lock, not a
        // count (P5 tuning). recordFailure is pinned to :53 so the attemptsRemaining
        // decrement at :60 stays killable.
        // L-TOKEN: Str::random(40) invite/resend token length - no design surface pins
        // 40 (P5 tuning; LeaveDates never pins Str::random lengths).
        "IncrementInteger": {
            ignore: [
                "App\\Foundation\\Auth\\Totp\\CacheLoginChallengeStore::recordFailure::53",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\RegenerateRecoveryCodesInteractor::execute",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeMatchingRecoveryCode",
                "App\\Companies\\Memberships\\UseCases\\Interactors\\InviteUserInteractor::execute",
                "App\\Companies\\Memberships\\UseCases\\Interactors\\ResendInvitationInteractor::execute",
            ],
        },
        "DecrementInteger": {
            ignore: [
                "App\\Foundation\\Auth\\Totp\\CacheLoginChallengeStore::recordFailure::53",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\RegenerateRecoveryCodesInteractor::execute",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeMatchingRecoveryCode",
            ],
        },
        // L-SCHEMA (P8): SubscriptionResource trial_ends_at?-> is equivalent while no
        // writer nulls trial_ends_at (the projector copies a non-nullable CarbonImmutable).
        // Pinned to :31 so the sibling cancelled_at?-> at :36 stays killed. REMOVE WHEN a
        // post-trial subscription writer lands (chunk-2 UC-1-042 / reactivation).
        // L-EQUIV-MISC: compositeKey() and isCurrentSession() run behind auth:sanctum -
        // user() is never null in flight. REMOVE WHEN either is mounted on a route
        // without auth:sanctum.
        // L-SCHEMA: the DSAR profile / membership sections read created_at, which
        // Eloquent stamps on every users / company_user insert (the projector create and
        // the pivot attach); pinned so the sibling email_verified_at?-> / last_logged_at?->
        // lines stay killed. REMOVE WHEN a writer inserts either row without timestamps.
        // L-SCHEMA: the DSAR sign-ins section reads a token's created_at (Eloquent stamps
        // it on insert) and expires_at (SessionIssuer, the one createToken caller, always
        // passes expiresAt); pinned so the sibling last_used_at?-> line stays killed.
        // REMOVE WHEN a token is minted without timestamps or without an expiry.
        // L-SCHEMA: the DSAR notifications section reads a notice's created_at (the
        // database channel inserts through Eloquent, which stamps it) and a
        // preference's updated_at (stamped on every Eloquent insert); pinned so the
        // sibling read_at?-> line stays killed. REMOVE WHEN a writer inserts either
        // row without timestamps.
        "NullSafeMethodCall": {
            ignore: [
                "App\\Billing\\Subscriptions\\IO\\Http\\Resources\\SubscriptionResource::toArray::31",
                "App\\Foundation\\Http\\Middleware\\EnsureIdempotencyKey::compositeKey",
                "App\\Foundation\\Auth\\IO\\Http\\Resources\\SessionResource::isCurrentSession",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\ProfileSection::collect::28",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\MembershipSection::collect::30",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\SignInsSection::collect::30",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\SignInsSection::collect::32",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\NotificationsSection::notificationsOf::48",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\NotificationsSection::preferencesOf::68",
            ],
        },
        // L-EQUIV-MISC: invitations.role_id and company_user.role_id are NOT NULL + FK
        // (the role always resolves); the seeded owner role is a schema invariant
        // (Company::owner). REMOVE WHEN a migration makes either role_id nullable /
        // drops its FK, or an owner-less company state is introduced.
        "NullSafePropertyCall": {
            ignore: [
                "App\\Companies\\Memberships\\IO\\Http\\Resources\\InvitationResource::toArray",
                "App\\Companies\\Entities\\Company::owner",
                "App\\Compliance\\Dsar\\UseCases\\Sections\\MembershipSection::collect",
            ],
        },
        // L-EQUIV-MISC: whereKey(null) yields IS NULL on a PK (the same empty result);
        // where('user_id', null) matches nothing; the recovery loop's early `return;`
        // (:99) only skips later iterations - $matched cannot change once true, and a
        // second iteration could consume another code only if two stored hashes matched
        // the same plaintext (bcrypt makes that unreachable).
        "ReturnRemoval": {
            ignore: [
                "App\\Models\\User::liveDefaultCompanyId",
                "App\\Companies\\Memberships\\UseCases\\Interactors\\InviteUserInteractor::removedMembershipId",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeMatchingRecoveryCode",
            ],
        },
        // L-EQUIV-MISC: $user->refresh() at :92 matters only across concurrent requests
        // (code review guards it; no single-process test can); $user->save() at :120 is
        // masked by issueSession()'s later save on the same instance - equivalent only
        // for THIS caller, and the mutant does move the column write outside the
        // DB::transaction, so the call is a review-guarded invariant, not dead code
        // (never delete it under amendment Q). REMOVE WHEN consumeRecoveryCode() gains
        // a caller that does not save the user afterwards. Pinned so the Cache::lock
        // (:91), consumeRecoveryCode() (:96), DB::transaction (:118) and ->persist()
        // (:122) calls stay killable.
        "MethodCallRemoval": {
            ignore: [
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeMatchingRecoveryCode::92",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeRecoveryCode::120",
            ],
        },
        // L-EQUIV-MISC: array_values() re-indexes the remaining codes for readers that
        // never look at the keys.
        "UnwrapArrayValues": {
            ignore: [
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::consumeRecoveryCode",
            ],
        },
        // L-EQUIV-MISC: snapshot() - the declared array shape (body: string,
        // content_type: string) vs getContent(): string|false and headers->get(): ?string;
        // the PHPDoc demands the casts. execute() - the TOTP secret is never null for an
        // enrolled user.
        "CastString": {
            ignore: [
                "App\\Foundation\\Http\\Middleware\\EnsureIdempotencyKey::snapshot",
                "App\\Foundation\\Auth\\UseCases\\Interactors\\VerifyTwoFactorInteractor::execute",
                // L-DSAR-REPORT-VALUE: every scalar a DSAR section exports is a string or
                // a bool / null handled before these arms (the sections write ISO strings,
                // ids and codes); the casts only satisfy Larastan's mixed. Remove when a
                // section exports an int or float.
                "App\\Compliance\\Dsar\\UseCases\\Reports\\DsarReportPresenter::readable::120",
                "App\\Compliance\\Dsar\\UseCases\\Reports\\DsarReportPresenter::readable::121",
            ],
        },
        // L-WHOLE-DAYS: both dates sit at start of day in UTC (no DST), so diffInDays()
        // returns a whole-number float, which the non-strict int return type coerces
        // without loss - the (int) cast only satisfies Larastan. REMOVE WHEN
        // declare(strict_types=1) lands: the uncast float becomes a TypeError.
        "CastInt": {
            ignore: [
                "App\\Compliance\\Dsar\\Entities\\DsarRequestRecord::daysRemaining",
            ],
        },
        "AssignCoalesce": {
            ignore: [
                // L-ROLE-NAMES-MEMO: the role names are read once per report; without the
                // memo every role cell re-reads the same rows - the same output, more
                // queries (performance only, no behaviour). Remove when the role names come
                // from a cached repository.
                "App\\Compliance\\Dsar\\UseCases\\Reports\\DsarReportPresenter::roleNames::146",
            ],
        },
    },
    minMsi: 80,
    minCoveredMsi: 85,
    testFramework: "phpunit"
}
