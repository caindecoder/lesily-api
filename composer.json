{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "darkaonline/l5-swagger": "^11.0",
        "google/auth": "^1.55.2",
        "laravel/framework": "^13.7",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "nyholm/psr7": "^1.8",
        "phpseclib/phpseclib": "^3.0.57",
        "pragmarx/google2fa": "^9.0",
        "propaganistas/laravel-phone": "^6.1",
        "railsware/mailtrap-php": "^3.11",
        "sentry/sentry-laravel": "^4.25",
        "spatie/browsershot": "^5.4",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-event-sourcing": "^7.15",
        "spatie/laravel-pdf": "^2.12",
        "symfony/http-client": "^8.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.20",
        "colinodell/json5": "^3.0",
        "fakerphp/faker": "^1.23",
        "infection/infection": "^0.35",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.29",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.6",
        "nikic/php-parser": "^5.9",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Conventions\\": "conventions/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "test:coverage": "@php artisan test --coverage",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyse",
        "mutate": "vendor/bin/infection",
        "mutate:local": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv PAO_DISABLE=1",
            "php -d auto_prepend_file= vendor/infection/infection/bin/infection --threads=1"
        ],
        "quality": [
            "@lint",
            "@analyze",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
