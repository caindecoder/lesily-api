includes:
    - ./vendor/larastan/larastan/extension.neon
    - ./conventions/PHPStan/variable-names-offenders.neon  # §2.26 VN7/VN10: today's misnamed variables; each rename increment deletes its entries, the last deletes the file

rules:
    - Conventions\PHPStan\ModelKeyReadRule
    - Conventions\PHPStan\VariableNameRule

services:
    - {class: Conventions\PHPStan\VariableNames\MethodParametersCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\PropertiesCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\AssignedLocalsCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\CaughtExceptionsCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\ForeachValuesCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\ClosureParametersCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\ArrowFunctionParametersCollector, tags: [phpstan.collector]}
    - {class: Conventions\PHPStan\VariableNames\FunctionParametersCollector, tags: [phpstan.collector]}

parameters:
    level: 8
    paths:
        - app
        - database/factories
        - database/seeders
        - tests
        - scripts  # s186 V5: the kill-verdict gate + crap radar are L8 code too (the s185 PHPStan-clean claim was vacuous without this)
        - conventions
    excludePaths:
        - tests/Unit/Conventions/Fixtures/*  # rule fixtures: written to violate the rules they test
    # tests/* scoped ignores — locked session 044, re-added session 057 (Phase 5a UC-1-097 redo)
    # per spec §1 D1 ("tests/* PHPStan ignores — only re-add IF rewritten tests trigger them").
    # Conflict resolution: §2.8 LeaveDates style baseline forbids descriptive PHPDoc on test
    # helpers, but PHPStan Level 8 demands generic + iterable-value annotations. Scoped ignore
    # to tests/* (not app/) preserves convention divergence without weakening production gate.
    # NOT a Rule #13 violation — the convention itself creates the situation; this is documented
    # convention divergence, not CI-symptom bypass. Production (app/, database/) stays Level 8.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: tests/*
        -
            identifier: missingType.generics
            path: tests/*
