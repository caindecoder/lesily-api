includes:
    - ./vendor/larastan/larastan/extension.neon

rules:
    - Conventions\PHPStan\ModelKeyReadRule

parameters:
    level: 8
    paths:
        - app
        - database/factories
        - database/seeders
        - tests
        - scripts  # s186 V5: the kill-verdict gate + crap radar are L8 code too (the s185 PHPStan-clean claim was vacuous without this)
        - conventions
    excludePaths:
        - tests/Unit/Conventions/Fixtures/*  # rule fixtures: written to violate the rules they test
    # tests/* scoped ignores — locked session 044, re-added session 057 (Phase 5a UC-1-097 redo)
    # per spec §1 D1 ("tests/* PHPStan ignores — only re-add IF rewritten tests trigger them").
    # Conflict resolution: §2.8 LeaveDates style baseline forbids descriptive PHPDoc on test
    # helpers, but PHPStan Level 8 demands generic + iterable-value annotations. Scoped ignore
    # to tests/* (not app/) preserves convention divergence without weakening production gate.
    # NOT a Rule #13 violation — the convention itself creates the situation; this is documented
    # convention divergence, not CI-symptom bypass. Production (app/, database/) stays Level 8.
    ignoreErrors:
        -
            identifier: missingType.iterableValue
            path: tests/*
        -
            identifier: missingType.generics
            path: tests/*
